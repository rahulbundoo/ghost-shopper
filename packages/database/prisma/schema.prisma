generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  // Canonical myshopify.com domain is the tenant ID; custom domains are display data only.
  id                  String               @id
  shopifyId           String?              @unique
  name                String?
  storefrontUrl       String?
  currencyCode        String?
  scopes              String               @default("")
  installedAt         DateTime?
  uninstalledAt       DateTime?
  syncedAt            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  monitors            Monitor[]
  runs                TestRun[]
  notificationChannel NotificationChannel?
  emailDeliveries     EmailDelivery[]
  subscription        Subscription?
  usageRecords        UsageRecord[]
}

model RateLimitBucket {
  key         String   @id @db.VarChar(64)
  windowStart DateTime
  count       Int

  @@index([windowStart])
}

// Deliberately independent of tenant FKs so deletion intent survives privacy erasure.
model ArtifactDeletion {
  storageKey     String    @id
  nextAttemptAt  DateTime
  leaseToken     String?   @db.Uuid
  leaseExpiresAt DateTime?
  attempts       Int       @default(0)
  lastError      String?   @db.VarChar(40)

  @@index([nextAttemptAt])
}

model ServiceHeartbeat {
  id        String   @id @db.VarChar(64)
  updatedAt DateTime
}

enum Scenario {
  PURCHASE_JOURNEY
}

enum DeviceProfile {
  DESKTOP
  MOBILE
}

enum MonitorFrequency {
  HOURLY
  EVERY_SIX_HOURS
  DAILY
}

enum RunStatus {
  QUEUED
  RUNNING
  COLLECTING
  ANALYZING
  COMPLETED
  ERROR
  CANCELLED
}

enum RunOutcome {
  PASSED
  WARNING
  FAILED
  ERROR
  CANCELLED
}

model Monitor {
  id             String           @id @default(uuid()) @db.Uuid
  shopId         String
  shop           Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String           @db.VarChar(120)
  scenario       Scenario         @default(PURCHASE_JOURNEY)
  productId      String
  variantId      String?
  device         DeviceProfile
  frequency      MonitorFrequency @default(DAILY)
  enabled        Boolean          @default(true)
  version        Int              @default(1)
  nextRunAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  runs           TestRun[]
  incidentScopes IncidentScope[]

  @@unique([shopId, id])
  @@index([shopId, createdAt, id])
  @@index([enabled, nextRunAt, id])
}

model TestRun {
  id                  String               @id @default(uuid()) @db.Uuid
  shopId              String
  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  monitorId           String               @db.Uuid
  // Database-level protection against linking a run to another tenant's monitor.
  monitor             Monitor              @relation(fields: [shopId, monitorId], references: [shopId, id], onDelete: Cascade)
  monitorVersion      Int
  scenario            Scenario
  productId           String
  variantId           String?
  device              DeviceProfile
  status              RunStatus            @default(QUEUED)
  outcome             RunOutcome?
  createdAt           DateTime             @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  // Durable dispatch intent is written in the same INSERT as the run.
  dispatchRequested   Boolean              @default(false)
  nextDispatchAt      DateTime             @default(now())
  attemptCount        Int                  @default(0)
  leaseToken          String?              @db.Uuid
  leaseExpiresAt      DateTime?
  errorCode           String?
  steps               RunStep[]
  artifacts           Artifact[]
  analyses            RunAnalysis[]
  aiAnalyses          AiAnalysis[]
  incidentOccurrences IncidentOccurrence[]
  lastSeenIncidents   Incident[]           @relation("IncidentLastRun")
  resolvedIncidents   Incident[]           @relation("IncidentResolvedRun")
  emailDeliveries     EmailDelivery[]
  usageRecord         UsageRecord?

  @@unique([shopId, id])
  @@index([shopId, createdAt, id])
  @@index([shopId, monitorId, createdAt, id])
  @@index([dispatchRequested, status, nextDispatchAt])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  INACTIVE
}

model Subscription {
  shopId            String             @id
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status            SubscriptionStatus @default(TRIAL)
  trialEndsAt       DateTime
  everPaid          Boolean            @default(false)
  providerId        String?
  policyKey         String?
  periodEnd         DateTime?
  verifiedAt        DateTime?
  syncStartedAt     DateTime?
  nextSyncAt        DateTime           @default(now())
  checkoutToken     String?            @db.Uuid
  checkoutExpiresAt DateTime?
  approvalUrl       String?

  @@index([nextSyncAt])
}

model UsageRecord {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  runId     String   @db.Uuid
  run       TestRun  @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade)
  periodKey String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@unique([shopId, runId])
  @@index([shopId, periodKey])
}

enum JourneyActionName {
  OPEN_HOME
  FIND_PRODUCT
  OPEN_PRODUCT
  SELECT_VARIANT
  ADD_TO_CART
  OPEN_CART
  BEGIN_CHECKOUT
}

enum StepStatus {
  PASSED
  FAILED
  SKIPPED
}

enum StepErrorCode {
  PAGE_UNAVAILABLE
  PRODUCT_NOT_FOUND
  VARIANT_UNAVAILABLE
  VARIANT_SELECTOR_FAILURE
  ADD_TO_CART_FAILURE
  CART_FAILURE
  CHECKOUT_FAILURE
  ACTION_TIMEOUT
  UNSAFE_NAVIGATION
  RUN_ABORTED
  PREVIOUS_STEP_FAILED
}

model RunStep {
  id           String            @id @default(uuid()) @db.Uuid
  shopId       String
  runId        String            @db.Uuid
  run          TestRun           @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade)
  attempt      Int
  action       JourneyActionName
  position     Int
  status       StepStatus
  startedAt    DateTime
  finishedAt   DateTime
  durationMs   Int
  currentUrl   String?           @db.VarChar(2048)
  errorCode    StepErrorCode?
  errorMessage String?           @db.VarChar(240)
  artifacts    Artifact[]
  findings     Finding[]

  @@unique([shopId, runId, attempt, position])
  @@unique([shopId, runId, attempt, id])
}

enum ArtifactType {
  SCREENSHOT
  TRACE
  CONSOLE
  NETWORK
  METADATA
}

enum ArtifactStatus {
  PENDING
  READY
  FAILED
}

model Artifact {
  id           String         @id @db.Uuid
  shopId       String
  runId        String         @db.Uuid
  run          TestRun        @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade)
  attempt      Int
  stepId       String?        @db.Uuid
  stepPosition Int?
  step         RunStep?       @relation(fields: [shopId, runId, attempt, stepId], references: [shopId, runId, attempt, id], onDelete: Cascade)
  type         ArtifactType
  storageKey   String         @unique
  mimeType     String
  sizeBytes    Int
  sha256       String         @db.VarChar(64)
  status       ArtifactStatus @default(PENDING)
  errorCode    String?
  createdAt    DateTime       @default(now())
  expiresAt    DateTime
  findings     Finding[]

  @@unique([shopId, runId, attempt, id])
  @@index([shopId, runId, attempt, createdAt])
  @@index([expiresAt])
}

enum FindingType {
  PAGE_UNAVAILABLE
  PRODUCT_NOT_FOUND
  BROKEN_IMAGE
  VARIANT_UNAVAILABLE
  VARIANT_SELECTOR_FAILURE
  ADD_TO_CART_FAILURE
  CART_FAILURE
  CHECKOUT_FAILURE
  HTTP_ERROR
  JS_ERROR
  SLOW_PAGE
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingSource {
  DETECTED
}

enum FindingEvidenceType {
  SCREENSHOT
  CONSOLE
  NETWORK
}

enum AnalysisOutcome {
  PASSED
  WARNING
  FAILED
}

model RunAnalysis {
  shopId       String
  runId        String          @db.Uuid
  attempt      Int
  run          TestRun         @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade)
  rulesVersion String          @db.VarChar(40)
  score        Int?
  complete     Boolean
  outcome      AnalysisOutcome
  createdAt    DateTime        @default(now())
  findings     Finding[]

  @@id([shopId, runId, attempt])
}

enum AiAnalysisStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model AiAnalysis {
  id               String           @id @default(uuid()) @db.Uuid
  shopId           String
  runId            String           @db.Uuid
  attempt          Int
  run              TestRun          @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade)
  provider         String           @db.VarChar(40)
  model            String           @db.VarChar(100)
  promptVersion    String           @db.VarChar(64)
  inputHash        String           @db.VarChar(64)
  requestedAt      DateTime
  responseAt       DateTime?
  expiresAt        DateTime
  latencyMs        Int?
  status           AiAnalysisStatus @default(RUNNING)
  evidenceSteps    Int[]
  pricing          Json
  usage            Json?
  estimatedCostUsd Decimal?         @db.Decimal(14, 8)
  result           Json?
  errorCode        String?          @db.VarChar(64)

  @@unique([shopId, runId, attempt])
  @@index([status, expiresAt])
}

model Finding {
  id                  String               @id @default(uuid()) @db.Uuid
  shopId              String
  runId               String               @db.Uuid
  attempt             Int
  analysis            RunAnalysis          @relation(fields: [shopId, runId, attempt], references: [shopId, runId, attempt], onDelete: Cascade)
  type                FindingType
  severity            Severity
  source              FindingSource        @default(DETECTED)
  fingerprint         String               @db.VarChar(64)
  title               String               @db.VarChar(120)
  description         String               @db.VarChar(500)
  stepPosition        Int?
  stepId              String?              @db.Uuid
  step                RunStep?             @relation(fields: [shopId, runId, attempt, stepId], references: [shopId, runId, attempt, id], onDelete: Cascade)
  evidenceType        FindingEvidenceType
  evidenceArtifactId  String?              @db.Uuid
  evidence            Artifact?            @relation(fields: [shopId, runId, attempt, evidenceArtifactId], references: [shopId, runId, attempt, id], onDelete: NoAction)
  occurrences         Int
  createdAt           DateTime             @default(now())
  incidentOccurrences IncidentOccurrence[]

  @@unique([shopId, runId, attempt, fingerprint])
  @@unique([shopId, runId, attempt, id])
  @@index([shopId, fingerprint])
}

model IncidentScope {
  shopId                String
  monitorId             String          @db.Uuid
  configKey             String          @db.VarChar(64)
  monitor               Monitor         @relation(fields: [shopId, monitorId], references: [shopId, id], onDelete: Cascade)
  lastCleanRunCreatedAt DateTime?
  lastCleanRunId        String?         @db.Uuid
  lastCleanCompletedAt  DateTime?
  incidents             Incident[]
  emailDeliveries       EmailDelivery[]

  @@id([shopId, monitorId, configKey])
}

model Incident {
  id                   String               @id @default(uuid()) @db.Uuid
  shopId               String
  monitorId            String               @db.Uuid
  configKey            String               @db.VarChar(64)
  scope                IncidentScope        @relation(fields: [shopId, monitorId, configKey], references: [shopId, monitorId, configKey], onDelete: Cascade)
  fingerprint          String               @db.VarChar(64)
  type                 FindingType
  severity             Severity
  title                String               @db.VarChar(120)
  description          String               @db.VarChar(500)
  status               IncidentStatus
  occurrenceCount      Int                  @default(0)
  firstSeenAt          DateTime
  lastSeenAt           DateTime
  lastSeenRunId        String               @db.Uuid
  lastSeenRunCreatedAt DateTime
  lastSeenRun          TestRun              @relation("IncidentLastRun", fields: [shopId, lastSeenRunId], references: [shopId, id], onDelete: NoAction)
  resolvedAt           DateTime?
  resolvedRunId        String?              @db.Uuid
  resolvedRun          TestRun?             @relation("IncidentResolvedRun", fields: [shopId, resolvedRunId], references: [shopId, id], onDelete: NoAction)
  occurrences          IncidentOccurrence[]

  @@unique([shopId, id])
  @@unique([shopId, monitorId, configKey, fingerprint])
  @@index([shopId, status, lastSeenAt, id])
  @@index([shopId, monitorId, status])
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model IncidentOccurrence {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String
  incidentId String   @db.Uuid
  incident   Incident @relation(fields: [shopId, incidentId], references: [shopId, id], onDelete: Cascade)
  runId      String   @db.Uuid
  run        TestRun  @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade)
  attempt    Int
  findingId  String   @db.Uuid
  finding    Finding  @relation(fields: [shopId, runId, attempt, findingId], references: [shopId, runId, attempt, id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([shopId, incidentId, runId])
  @@unique([shopId, findingId])
  @@index([shopId, incidentId, createdAt, id])
}

// Field names follow Shopify's official Prisma adapter. The persisted tenant column
// is shopId; the adapter calls it "shop". The FK prevents orphan/cross-tenant records.
model Session {
  id                  String    @id
  shop                String    @map("shopId")
  tenant              Shop      @relation(fields: [shop], references: [id], onDelete: Cascade)
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model NotificationChannel {
  shopId          String   @id
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email           String   @db.VarChar(254)
  enabled         Boolean  @default(false)
  recoveryEnabled Boolean  @default(true)
  version         Int      @default(1)
  nextSendAt      DateTime @default(now())
}

enum EmailKind {
  FAILURE
  RECOVERY
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

model EmailDelivery {
  id             String        @id @default(uuid()) @db.Uuid
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  runId          String        @db.Uuid
  run            TestRun       @relation(fields: [shopId, runId], references: [shopId, id], onDelete: Cascade)
  monitorId      String        @db.Uuid
  configKey      String        @db.VarChar(64)
  scope          IncidentScope @relation(fields: [shopId, monitorId, configKey], references: [shopId, monitorId, configKey], onDelete: Cascade)
  kind           EmailKind
  recipient      String        @db.VarChar(254)
  channelVersion Int
  status         EmailStatus   @default(PENDING)
  attemptCount   Int           @default(0)
  createdAt      DateTime      @default(now())
  firstAttemptAt DateTime?
  nextAttemptAt  DateTime      @default(now())
  leaseToken     String?       @db.Uuid
  leaseExpiresAt DateTime?
  finishedAt     DateTime?

  @@unique([shopId, runId, kind])
  @@index([status, nextAttemptAt])
  @@index([shopId, monitorId, configKey, kind, status])
}
