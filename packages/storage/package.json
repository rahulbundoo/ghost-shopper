{
  "name": "@ghostshopper/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private S3-compatible artifact storage adapters (Phase 5).",
  "dependencies": {
    "@ghostshopper/application": "workspace:*",
    "@ghostshopper/domain": "workspace:*",
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
