{
  "name": "ghostshopper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.15.0 <23",
    "pnpm": ">=10.34.6 <11"
  },
  "scripts": {
    "test:storage": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project storage",
    "test:browser": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project browser",
    "browser:install": "pnpm --filter @ghostshopper/browser exec playwright install chromium --only-shell",
    "dev": "pnpm run build:packages && pnpm --filter @ghostshopper/web dev",
    "start": "pnpm --filter @ghostshopper/web start",
    "dev:runner": "pnpm run build:runner && pnpm --filter @ghostshopper/runner start",
    "start:runner": "pnpm --filter @ghostshopper/runner start",
    "test:queue": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project queue",
    "shopify": "shopify",
    "dev:shopify": "pnpm run build:packages && shopify app dev",
    "build:packages": "pnpm --filter \"./packages/**\" --fail-if-no-match run build",
    "db:generate": "pnpm --filter @ghostshopper/database generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:database": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project database",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @ghostshopper/web... run build",
    "build:runner": "pnpm --filter @ghostshopper/runner... run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "pnpm run build && vitest run --project integration",
    "test:infra": "vitest run --project infrastructure",
    "check": "pnpm run build:packages && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test:unit && pnpm run test:integration",
    "infra:config": "docker compose -f docker/compose.yaml config --quiet",
    "infra:up": "docker compose -f docker/compose.yaml up -d --wait postgres redis minio && docker compose -f docker/compose.yaml run --build --rm --no-deps minio-init",
    "infra:down": "docker compose -f docker/compose.yaml down",
    "infra:logs": "docker compose -f docker/compose.yaml logs --tail 100",
    "security:check": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "playwright": "1.63.0",
    "bullmq": "6.3.10",
    "@shopify/cli": "4.8.2",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
