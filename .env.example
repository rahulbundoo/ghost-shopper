# Phase 1: run Node directly and use a native or remote PostgreSQL database.
# Copy this file to .env; never commit credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Shopify CLI supplies the HTTPS tunnel origin during pnpm dev:shopify.
SHOPIFY_APP_URL=
DATABASE_URL=
# Dedicated test database only; apply the migration to it before test:database.
TEST_DATABASE_URL=
# Phase 3: native/remote Redis, with persistence and maxmemory-policy=noeviction.
REDIS_URL=
TEST_REDIS_URL=
QUEUE_PREFIX=ghostshopper
RUNNER_CONCURRENCY=2
RUN_TIMEOUT_MS=120000
# Phase 4: use an existing Chrome installation locally, without browser downloads.
# CI/deployment uses chromium after pnpm browser:install.
BROWSER_CHANNEL=chrome
ACTION_TIMEOUT_MS=10000
PORT=3000

# Phase 5: existing private S3-compatible bucket; never public-read.
# HTTPS remotely; HTTP is accepted only for loopback development endpoints.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ghostshopper-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
ARTIFACT_RETENTION_DAYS=7
# Dedicated storage test bucket/credentials only (never production).
TEST_S3_ENDPOINT=
TEST_S3_REGION=us-east-1
TEST_S3_BUCKET=
TEST_S3_ACCESS_KEY_ID=
TEST_S3_SECRET_ACCESS_KEY=
TEST_S3_FORCE_PATH_STYLE=true

# Phase 8: explicitly opt in to sending masked storefront screenshots to OpenAI.
# Disabled by default; never needed for deterministic monitoring.
AI_ENABLED=false
OPENAI_API_KEY=
# Choose a Responses API model supporting images + strict structured outputs.
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2048
# Set current USD rates per million tokens for that model; no guessed prices.
AI_INPUT_USD_PER_MILLION=
AI_CACHED_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Optional Phase 0 Docker infrastructure defaults, unused by Phase 1.
# Production credentials must come from a secret manager.
POSTGRES_USER=ghostshopper
POSTGRES_PASSWORD=ghostshopper_local_only
POSTGRES_DB=ghostshopper
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_ROOT_USER=ghostshopper_local
MINIO_ROOT_PASSWORD=ghostshopper_local_only
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
